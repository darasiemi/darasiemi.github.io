{% assign related_count = 0 %}
{% assign heading_shown = false %}

{% for post in site.posts %}
  {% if post.url != page.url %}
    {% assign tag_match = false %}
    {% assign category_match = false %}

    {% if site.related_blog_posts.match_tags %}
      {% for tag in post.tags %}
        {% if page.tags contains tag %}
          {% assign tag_match = true %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if site.related_blog_posts.match_categories %}
      {% for category in post.categories %}
        {% if page.categories contains category %}
          {% assign category_match = true %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if tag_match or category_match %}
      {% unless heading_shown %}
        {% assign heading_shown = true %}

        <br>
        <hr>
        <br>

        <!-- Adds related posts to the end of an article -->
        <h2 class="text-3xl font-semibold mb-4 mt-12">Enjoy Reading This Article?</h2>
        <p class="mb-2">Here are some more articles you might like to read next:</p>

        <ul class="list-disc pl-8">
      {% endunless %}

      <li class="my-2">
        <a
          class="text-pink-700 underline font-semibold hover:text-pink-800"
          href="{{ site.baseurl }}{{ post.url }}"
        >
          {{ post.title }}
        </a>
      </li>

      {% assign related_count = related_count | plus: 1 %}

      {% if related_count >= site.related_blog_posts.max_related %}
        {% break %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endfor %}

{% if heading_shown %}
  </ul>
{% endif %}
