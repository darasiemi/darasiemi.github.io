<!--
  ── Preloader ─────────────────────────────────────────────────────────────
  Terminal-style boot screen shown while the page's heavy assets warm up.
  Inline CSS + inline JS so it paints before any external stylesheet or
  script loads, which is what prevents the "artifacts scatter in" effect
  on first visit. Skipped on repeat navigations in the same session.
-->
<style id="preloader-critical-css">
  .site-preloader {
    position: fixed !important;
    inset: 0 !important;
    z-index: 10000 !important;
    background-color: #0a0a0b !important;
    color: #ffffff !important;
    color-scheme: dark;
    display: flex !important;
    align-items: center;
    justify-content: center;
    transform: translateY(0);
    will-change: transform;
    transition: transform 340ms cubic-bezier(0.76, 0, 0.24, 1);
  }
  /* Slide the whole boot screen up off-stage — no opacity cross-fade, so
     text stays fully legible until the moment it leaves the viewport. */
  .site-preloader.is-hidden {
    transform: translateY(-100%);
    pointer-events: none;
  }
  /* Match body backdrop to preloader during load so no light flash leaks */
  body.is-loading {
    background-color: #0a0a0b !important;
  }
  .site-preloader-inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.4rem;
    width: min(380px, 82vw);
  }
  .site-preloader-signature {
    width: 180px;
    height: 58px;
    margin: 0 auto 0.4rem;
    background-color: #ffffff !important;
    -webkit-mask-image: url('/assets/img/darasimi-signature.png');
    mask-image: url('/assets/img/darasimi-signature.png');
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }
  .site-preloader-copy {
    font-family: 'Geist Mono', 'SF Mono', 'Menlo', monospace;
    font-size: 0.78rem;
    color: #ffffff !important;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .site-preloader-cursor {
    color: #10b981 !important;
    animation: site-preloader-blink 1s steps(2) infinite;
    margin-left: 1px;
  }
  @keyframes site-preloader-blink {
    50% {
      opacity: 0;
    }
  }
  .site-preloader-bar-wrap {
    width: 100%;
    height: 2px;
    background-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
    border-radius: 1px;
  }
  .site-preloader-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #0a7065 0%, #10b981 60%, #34d399 100%);
    transition: width 0.08s linear;
  }
  .site-preloader-meta {
    display: flex;
    justify-content: space-between;
    font-family: 'Geist Mono', 'SF Mono', 'Menlo', monospace;
    font-size: 0.68rem;
    color: #9ca3af !important;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  body.is-loading {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-preloader-cursor {
      animation: none;
    }
    .site-preloader {
      transition-duration: 0ms;
    }
  }
</style>

<div id="site-preloader" class="site-preloader" role="status" aria-live="polite" aria-label="Loading darasi.me">
  <div class="site-preloader-inner">
    <div class="site-preloader-signature" aria-hidden="true"></div>
    <div class="site-preloader-copy"><span>booting darasi.me</span><span class="site-preloader-cursor" aria-hidden="true">_</span></div>
    <div class="site-preloader-bar-wrap" aria-hidden="true">
      <div class="site-preloader-bar" id="site-preloader-bar"></div>
    </div>
    <div class="site-preloader-meta">
      <span>init(hero, bio, gallery)</span>
      <span id="site-preloader-percent">0%</span>
    </div>
  </div>
</div>

<script>
  (function () {
    var pre = document.getElementById('site-preloader');
    if (!pre) return;

    {% if page.url == '/' %}
      // Stage only the About page; without JavaScript all content remains visible.
      document.documentElement.classList.add('about-staged');
      if (new URLSearchParams(window.location.search).has('photo')) {
        document.documentElement.classList.add('terminal-done');
        // Strip the #gallery fragment so the browser's initial fragment-scroll
        // doesn't race the JS scrollIntoView that fires after Swiper mounts.
        // The ?photo= query is preserved so the gallery still picks the slide.
        if (window.location.hash === '#gallery' && window.history && window.history.replaceState) {
          window.history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }
      // Keep the page accessible if the terminal script cannot finish.
      setTimeout(function () {
        if (!document.documentElement.classList.contains('terminal-done')) {
          document.documentElement.classList.add('terminal-done');
          document.dispatchEvent(new CustomEvent('terminal:done'));
        }
      }, 15000);
    {% endif %}

    // Skip the full preloader on repeat loads in the same session so navigating
    // between pages doesn't replay the boot screen each time.
    var SESSION_KEY = 'preloader-shown';
    var isRepeat = false;
    try {
      isRepeat = window.sessionStorage && sessionStorage.getItem(SESSION_KEY) === '1';
    } catch (e) {
      /* storage may be unavailable; fall through to full preloader */
    }

    if (isRepeat) {
      pre.parentNode && pre.parentNode.removeChild(pre);
      return;
    }

    var MIN_DURATION = 400; // brief branded transition without delaying content
    var FADE_DURATION = 340; // matches .site-preloader transform transition
    var SAFETY_TIMEOUT = 3000; // force finish if DOM parsing stalls
    var bar = document.getElementById('site-preloader-bar');
    var pct = document.getElementById('site-preloader-percent');

    document.body.classList.add('is-loading');

    var start = performance.now();
    var minReached = false;
    var pageReady = false;
    var done = false;

    function tick(now) {
      if (done) return;
      var elapsed = now - start;
      var t = Math.min(elapsed / MIN_DURATION, 1);
      // ease-out cubic — fills fast, settles smoothly
      var eased = 1 - Math.pow(1 - t, 3);
      var displayPct = Math.floor(eased * 100);
      bar.style.width = displayPct + '%';
      pct.textContent = displayPct + '%';
      if (t >= 1) {
        minReached = true;
        maybeFinish();
        return;
      }
      requestAnimationFrame(tick);
    }

    function maybeFinish() {
      if (done || !minReached || !pageReady) return;
      done = true;
      try {
        sessionStorage.setItem(SESSION_KEY, '1');
      } catch (e) {
        /* ignore */
      }
      pre.classList.add('is-hidden');
      document.body.classList.remove('is-loading');
      document.dispatchEvent(new Event('site:revealing'));
      setTimeout(function () {
        if (pre.parentNode) pre.parentNode.removeChild(pre);
        document.dispatchEvent(new Event('site:ready'));
      }, FADE_DURATION + 50);
    }

    function onReady() {
      pageReady = true;
      maybeFinish();
    }

    if (document.readyState !== 'loading') {
      onReady();
    } else {
      document.addEventListener('DOMContentLoaded', onReady, { once: true });
    }

    requestAnimationFrame(tick);

    // Safety: never leave the preloader up forever
    setTimeout(function () {
      pageReady = true;
      minReached = true;
      maybeFinish();
    }, SAFETY_TIMEOUT);
  })();
</script>
