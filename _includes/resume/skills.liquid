<div class="skills-groups">
  {% for category in data[1] %}
    <div class="skills-group">
      <div class="skills-group-head">
        {% if category.icon %}
          <span class="skills-group-icon"><i class="{{ category.icon }}"></i></span>
        {% endif %}
        <h4 class="skills-group-name" data-toc-skip>{{ category.name }}</h4>
      </div>
      <ul class="skills-pills">
        {% for item in category.keywords %}
          {% if item.name %}
            {% assign item_name = item.name %}
            {% assign item_icon = item.icon %}
          {% else %}
            {% assign item_name = item %}
            {% assign item_icon = '' %}
          {% endif %}
          <li class="skills-pill">
            {% if item_icon != '' %}
              <i class="{{ item_icon }}" aria-hidden="true"></i>
            {% endif %}
            <span>{{ item_name }}</span>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}
</div>
<p class="skills-projects-link">
  <a href="{{ '/projects/' | relative_url }}">See these skills in my projects &rarr;</a>
</p>
